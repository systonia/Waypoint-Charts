{
    "name": "systonia/waypoint-charts",
    "description": "Server-rendered SVG charts for Waypoint: bar and line charts with a data table, legend and accessible markup, tooltips as a progressive enhancement.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^1.5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Waypoint\\Charts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waypoint\\Charts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
